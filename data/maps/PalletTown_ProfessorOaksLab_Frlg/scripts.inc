PalletTown_ProfessorOaksLab_EventScript_AideGiveBoxLinkTriggerLeft::
	lockall
	setvar VAR_TEMP_2, 1
	goto PalletTown_ProfessorOaksLab_EventScript_AideGiveBoxLink
	end

