Pallet_Text_Technology1::
  .string "Technology is incredible!\p"
  .string "You can now sort items in the bag\n"
  .string "using the Start button!$"


Pallet_Text_AutoRunSign1 ::
  .string "It's a posted notice...\p"
  .string "Press {L_BUTTON} to bring up the skills\n"
  .string "menu!$"


Pallet_Text_Mom::
  .string "{COLOR GREEN}Mom: {COLOR RED}Hi sweetie!\p"
  .string "Congratulations on becoming champ-\n"
  .string "ion!\p"
  .string "For the first time ever, I can final-\n"
  .string "ly say I'm proud of you!\p"
  .string "Great job!$"


Pallet_Text_MomPost ::
  .string "If you're looking for more\n"
  .string "trainers to fight, I hear a seer\l"
  .string "on Route 16 gives tickets to the\l"
  .string "Sevii Islands to those worthy...\p"
  .string "Perhaps you ought to give her a\n"
  .string "visit?\p"
  .string "Also...$"


Pallet_Text_Mom2::
  .string "{COLOR RED}There are a lot of new perks after\n"
  .string "becoming Champion.\p"
  .string "The EV training gear instantly max out\n"
  .string "the EVs for the respective stat.\p"
  .string "Oh, and the prize money from trainers\n"
  .string "is doubled!\p"
  .string "The rich just get richer, am I right?\p"
  .string "Well, good luck {COLOR GREEN}{PLAYER}!$"


Pallet_Text_MomCarePackage::
  .string "{COLOR RED}Oh, also!\n"
  .string "As a part of the care package cheat,\l"
  .string "these are yours!$"


mom_Text_RestText::
  .string "{COLOR GREEN}Mom: {PLAYER}!{COLOR RED}\n"
  .string "You should take a quick rest.$"


mom_Text_LookGreat::
  .string "{COLOR GREEN}Mom{COLOR RED}: Oh, good! You and your\n"
  .string "Pokémon are looking great.\l"
  .string "Take care now!$"


mom_Text_AllBoysTxt::
  .string "{COLOR GREEN}Mom:{COLOR RED} ...Right.\n"
  .string "All boys leave home someday.\l"
  .string "It said so on TV.\p"
  .string "Oh, yes. {COLOR GREEN}Prof. Oak{COLOR RED}, next door, was\n"
  .string "looking for you.$"


mom_Text_AllGirlsTxt::
  .string "{COLOR GREEN}Mom:{COLOR RED} ...Right.\n"
  .string "All girls dream of traveling.\l"
