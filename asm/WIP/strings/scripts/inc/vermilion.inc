ltsurge_Text_EncounterText::
  .string "{COLOR BLUE}Hey, kid! What do you think you're\n"
  .string "doing here?\p"
  .string "You won't live long in combat!\n"
  .string "Not with your puny power!\p"
  .string "I tell you, kid, electric Pokémon\n"
  .string "saved me during the war!\p"
  .string "They zapped my enemies into\n"
  .string "paralysis!\p"
  .string "The same as I'll do to you!$"


ltsurge_Text_DefeatText::
  .string "Now that's a shocker!\p"
  .string "You're the real deal, kid!\p"
  .string "Fine, then, take the Thunder Badge!$"


ltsurge_Text_Givetm::
  .string "{COLOR BLUE}You're special, kid!\n"
  .string "Take this!$"


ltsurge_Text_TMInfomsg::
  .string "{COLOR BLUE}TM92 contains Volt Switch!\p"
  .string "Teach it to an Electric Pokémon!$"


ltsurge_Text_Helloagain::
  .string "Kid! I was hoping to see you again.\p"
  .string "My Pokémon and I haven't forgotten\n"
  .string "that crazy ride we had with you.\p"
  .string "We're raring to get another shot at\n"
  .string "ya!$"


ltsurge_Text_Comeback::
  .string "Boo... Well, whenever you're ready.$"


ltsurge_Text_Battle::
  .string "I'm letting my beasts out!\p"
  .string "Here we go!$"


ltsurge_Text_Seconddefeat::
  .string "Another electrifying defeat!$"


ltsurge_Text_Won2text::
  .string "Heh, my Pokémon aren't keen on losing,\n"
  .string "but I can tell they're having a blast\l"
  .string "with you! You can have these.$"


