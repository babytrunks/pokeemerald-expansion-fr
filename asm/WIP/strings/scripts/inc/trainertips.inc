Cerulean_Text_TrainerTips1::
  .string "Trainer Tips\p"
  .string "Raid Dens can be fought multiple times!\n"
  .string "They reset at midnight.$"


Celadon_Text_TrainerTips1::
  .string "Trainer Tips\p"
  .string "Press {R_BUTTON} on the in-battle move\n"
  .string "menu to pull up a screen that dis-\l"
  .string "plays turns left for Weather,\l"
  .string "Terrain, Trick Room, and Screens!$"


Celadon_Text_TrainerTips2::
  .string "Trainer Tips\p"
  .string "Although item usage is not permitted\n"
  .string "in boss battles, held items are!\p"
  .string "When used properly, they can be a\n"
  .string "huge difference maker.$"


Saffron_Text_TrainerTips1::
  .string "Trainer Tips\p"
  .string "All Pokémon present in the party\n"
  .string "earn EVs if the Exp. Share is en-\l"
  .string "abled, even if they didn't partipate\l"
  .string "in battle.$"


Saffron_Text_TrainerTips2::
