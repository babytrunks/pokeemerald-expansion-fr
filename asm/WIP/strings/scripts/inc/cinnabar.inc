  .string "Too hot!$"


CinnabarGym_Text_AceTrainer2_3::
  .string "{COLOR GREEN}Blaziken, Cinderace...\n"
  .string "{COLOR RED}Those are popular Fire Pokémon.$"


CinnabarGym_Text_AceTrainer3_1::
