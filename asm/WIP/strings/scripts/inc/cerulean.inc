misty_Text_EncounterText::
  .string "Hi, you're a new face!\p"
  .string "Only those trainers who have a\n"
  .string "policy about Pokémon can turn pro.\p"
  .string "What is your approach when you\n"
  .string "catch and train Pokémon?\p"
  .string "My policy is an all-out offensive\n"
  .string "with Water-type Pokémon!$"


misty_Text_DefeatText::
  .string "Wow!\n"
  .string "You're too much!\p"
  .string "All right!\p"
  .string "You can have the Cascade Badge to\n"
  .string "show you beat me.$"


misty_Text_Givetm::
  .string "The Cascade Badge allows you\n"
  .string "to use Cut anytime,\l"
  .string "even out of battle.\p"
  .string "You can Cut down small trees to\n"
  .string "open new pathways.\p"
  .string "You can also have my favorite TM.$"


misty_Text_TMInfomsg::
  .string "TM03 teaches Flip Turn.\p"
  .string "Use it on an aquatic Pokémon!$"


misty_Text_Helloagain::
  .string "Oh hey! Welcome back!\p"
  .string "You've returned at the nick of time!\p"
  .string "My Pokémon and I have actually been\n"
  .string "dying for a rematch.\p"
  .string "Although you already have my badge,\n"
  .string "I have special items to give as a\l"
  .string "reward.\p"
  .string "What do you say?$"


misty_Text_Comeback::
  .string "Oh... alright then.\p"
  .string "When you're ready, please do come\n"
  .string "back.$"


misty_Text_PostGame1::
  .string "Well, well. You're back again!\p"
  .string "You know what they say, third\n"
  .string "time's the charm.\p"
  .string "You up for another battle?$"


misty_Text_PostGame2::
  .string "This time there's no holding back!$"


misty_Text_ThirdDefeat::
  .string "Okay, okay.\n"
  .string "You're the real deal!$"


misty_Text_PostGame3::
  .string "You're a tough cookie alright.\p"
  .string "Thanks for entertaining me,\n"
  .string "I'm sure you knew I'd be a\l"
  .string "pushover.\p"
  .string "To thank you for your time,\n"
  .string "please, have this!$"


misty_Text_PostGame4::
  .string "Did you notice?\n"
  .string "My {COLOR GREEN}Drednaw{COLOR RED} has special access\l"
  .string "to Shell Smash!\p"
  .string "In its Mega Form, it rivals {COLOR GREEN}Mega\n"
  .string "Blastoise{COLOR RED} as one of the best Shell\l"
  .string "Smash users.\p"
  .string "You'd be silly not to try it,\n"
  .string "here!$"


Misty_Text_Drednaw::
  .string "{COLOR BLACK}You received a {COLOR GREEN}Drednaw!{COLOR BLACK}$"


misty_Text_Battle::
  .string "Cool! We're going all out this time!\p"
  .string "Prepare yourself!$"


Misty_Text_RematchDoneDone::
  .string "You've inspired me to keep training.\p"
  .string "When I'm satisfied, I'd love\n"
  .string "to hit the road and travel...$"


misty_Text_Seconddefeat::
  .string "Washed again...$"


misty_Text_Won2text::
  .string "As I thought, you're a super talent-\n"
  .string "ed trainer! As promised, here you go.$"


misty_Text_Info::
  .string "{COLOR GREEN}Mega Gyarados{COLOR RED} is a huge threat.\p"
  .string "It changes from Flying to Dark type,\n"
  .string "and boasts an even higher Attack\l"
  .string "stat!\p"
  .string "The Pokémon I've given is {COLOR GREEN}Finizen,\n"
  .string "{COLOR RED}a seemingly weak Water-type with\l"
  .string "a powerful evolved form.\p"
  .string "With these, you should be able to\n"
  .string "reach greater heights!$"


